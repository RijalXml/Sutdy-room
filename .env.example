# === StudyRoom — Environment Variables ===
# Salin file ini menjadi ".env" (untuk lokal) lalu isi dengan nilai asli dari
# dashboard Supabase project kamu. JANGAN PERNAH commit file ".env" yang
# sudah terisi ke git, dan JANGAN PERNAH taruh nilai ini di tempat publik.

# Supabase project URL. Dashboard Supabase -> Project Settings -> API -> Project URL.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase "anon" / public key. AMAN untuk frontend — kunci ini HANYA bisa
# melakukan apa yang diizinkan oleh RLS policy, tidak lebih.
# Dashboard Supabase -> Project Settings -> API -> Project API keys -> anon public.
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nama & zona waktu kelas, dipakai sebagai fallback di UI sebelum data
# "classes" dimuat dari database.
VITE_APP_NAME="StudyRoom"
VITE_DEFAULT_TIMEZONE="Asia/Jakarta"

# ---------------------------------------------------------------------------
# SERVER-ONLY — dipakai oleh Vercel Serverless Functions di folder /api,
# TIDAK PERNAH diawali VITE_, TIDAK PERNAH dikirim ke browser.
# Ini akan dibutuhkan pada Tahap E (fitur undang anggota). Belum dipakai oleh
# kode di rilis ini, tapi didokumentasikan di sini agar siap.
# ---------------------------------------------------------------------------

# Dashboard Supabase -> Project Settings -> API -> Project API keys -> service_role.
# Kunci ini punya akses penuh dan MELEWATI RLS. Hanya boleh dipakai di
# server (Vercel Function), isi lewat Vercel Environment Variables, JANGAN
# pernah ditaruh di file yang di-bundle ke frontend.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
